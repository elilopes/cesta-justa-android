rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Products (public read and write for catalog seeding)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Establishments (supermarkets / mercadinhos - public read and write)
    match /establishments/{establishmentId} {
      allow read, write: if true;
    }

    // Price entries (public read and write)
    match /prices/{priceId} {
      allow read, write: if true;
    }

    // Cloud-synced shopping lists
    match /shopping_lists/{listId} {
      allow read, write: if isAuthenticated();
    }

    // Promotions (public read and write)
    match /promotions/{promoId} {
      allow read, write: if true;
    }
  }
}
